# ─── AI (Phase 2) ───────────────────────────────────────────────
# Google AI Studio key. Streams chat + optional studio voice (TTS).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon

# ─── Desktop bridge (Phase 5) ───────────────────────────────────
# OFF unless exactly "1". macOS only; other platforms answer 501.
NEXUS_BRIDGE=0

# ─── Personal telemetry ─────────────────────────────────────────
# IGAA… → Instagram Login (graph.instagram.com, "me")
# EAA…  → Facebook Login (graph.facebook.com, needs INSTAGRAM_BUSINESS_ID)
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Portfolio: JSON array of {"symbol":"NVDA","shares":10,"cost":420.5}
NEXUS_PORTFOLIO=[{"symbol":"NVDA","shares":10,"cost":420},{"symbol":"AAPL","shares":15,"cost":180},{"symbol":"MSFT","shares":8,"cost":350}]

# Calendar: any private/public iCal (.ics) URL (Google: Settings → Integrate → Secret address)
NEXUS_CALENDAR_ICS=

# Projects: GitHub user whose repos become project worlds (+ optional nexus.projects.json)
NEXUS_GITHUB_USER=ryanpjackson1
GITHUB_TOKEN=

# Sports: ESPN league paths, comma separated
NEXUS_SPORTS=soccer/eng.1,basketball/nba,football/nfl
